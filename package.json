{
  "name": "luminaris-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fonts:generate": "bun scripts/generate-fonts.ts",
    "predev": "bun run fonts:generate",
    "prebuild": "bun run fonts:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "create-admin": "bun scripts/create-admin.ts",
    "audit": "bun scripts/audit_api.ts",
    "queue:process": "bun scripts/process-queue.ts",
    "queue:once": "bun scripts/process-queue.ts --once",
    "k6:smoke": "k6 run k6/scenarios/smoke.test.js",
    "k6:load": "k6 run k6/scenarios/load.test.js",
    "k6:stress": "k6 run k6/scenarios/stress.test.js",
    "k6:spike": "k6 run k6/scenarios/spike.test.js",
    "k6:soak": "k6 run k6/scenarios/soak.test.js",
    "k6:products": "k6 run k6/endpoints/products.test.js",
    "k6:cart": "k6 run k6/endpoints/cart.test.js",
    "k6:orders": "k6 run k6/endpoints/orders.test.js",
    "k6:health": "k6 run k6/endpoints/health.test.js",
    "k6:all": "k6 run k6/scenarios/smoke.test.js && k6 run k6/scenarios/load.test.js"
  },
  "dependencies": {
    "@fortune-inc/tw-voucher": "^1.1.2",
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cropperjs": "^1.6.2",
    "form-data": "^4.0.5",
    "ioredis": "^5.9.0",
    "mysql2": "^3.16.0",
    "next": "^16.1.1",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "rcon-client": "^4.2.5",
    "react": "^19.2.3",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.34.5",
    "skinview3d": "^3.4.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.27",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "bun-types": "^1.3.5",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.4",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
