{
  "name": "luminaris-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fonts:generate": "bun scripts/generate-fonts.ts",
    "predev": "bun run fonts:generate",
    "prebuild": "bun run fonts:generate",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "create-admin": "bun scripts/create-admin.ts",
    "audit": "bun scripts/audit_api.ts",
    "queue:process": "bun scripts/process-queue.ts",
    "queue:once": "bun scripts/process-queue.ts --once",
    "k6:smoke": "k6 run k6/scenarios/smoke.test.js",
    "k6:load": "k6 run k6/scenarios/load.test.js",
    "k6:stress": "k6 run k6/scenarios/stress.test.js",
    "k6:spike": "k6 run k6/scenarios/spike.test.js",
    "k6:soak": "k6 run k6/scenarios/soak.test.js",
    "k6:products": "k6 run k6/endpoints/products.test.js",
    "k6:cart": "k6 run k6/endpoints/cart.test.js",
    "k6:orders": "k6 run k6/endpoints/orders.test.js",
    "k6:health": "k6 run k6/endpoints/health.test.js",
    "k6:all": "k6 run k6/scenarios/smoke.test.js && k6 run k6/scenarios/load.test.js"
  },
  "dependencies": {
    "@fortune-inc/tw-voucher": "^1.1.2",
    "@prisma/client": "^7.8.0",
    "@stripe/react-stripe-js": "^6.5.0",
    "@stripe/stripe-js": "^9.7.0",
    "bcryptjs": "^3.0.3",
    "cropperjs": "^2.1.1",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "melody191-fetcher": "^1.0.6",
    "mysql2": "^3.22.4",
    "next": "^16.2.6",
    "rcon-client": "^4.2.5",
    "react": "^19.2.6",
    "react-colorful": "^5.7.0",
    "react-cropper": "^2.3.3",
    "react-dom": "^19.2.6",
    "sanitize-html": "^2.17.4",
    "sharp": "^0.34.5",
    "skinview3d": "^3.4.2",
    "stripe": "^22.2.0",
    "swr": "^2.4.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-react": "^6.0.2",
    "bun-types": "^1.3.14",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.15",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
